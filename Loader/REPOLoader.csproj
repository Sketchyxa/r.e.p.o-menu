<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Loader</AssemblyName>
    <RootNamespace>REPOLoader</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <SmiDll Condition="Exists('..\libs\SharpMonoInjector.dll')">..\libs\SharpMonoInjector.dll</SmiDll>
    <SmiDll Condition="'$(SmiDll)' == '' and Exists('..\SharpMonoInjector.Console\SharpMonoInjector.dll')">..\SharpMonoInjector.Console\SharpMonoInjector.dll</SmiDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- SharpMonoInjector (MIT): libs\SharpMonoInjector.dll (см. libs\README.md) -->
    <Reference Include="SharpMonoInjector">
      <HintPath>$(SmiDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CheckSmi" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SmiDll)' == ''" Text="SharpMonoInjector.dll not found. Put it into the libs folder (see libs/README.md)." />
  </Target>

</Project>
